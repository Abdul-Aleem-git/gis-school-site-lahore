# ═══════════════════════════════════════════
# .gitignore — GIS School Site Selection
# ═══════════════════════════════════════════

# ── Large data files (too big for GitHub) ──
Data/*.tif
Data/*.geotiff
Data/pak_pop_2024_CN_100m_R2025A_v1.tif

# ── Road network file (regenerated by notebook) ──
Outputs/lahore_road_network.graphml

# ── Notebook checkpoints ──
.ipynb_checkpoints/
**/.ipynb_checkpoints/

# ── Python cache ──
__pycache__/
*.pyc
*.pyo

# ── OS files ──
.DS_Store
Thumbs.db
desktop.ini

# ── VS Code ──
.vscode/

# ── Jupyter runtime ──
.jupyter/

# ── Virtual environments ──
venv/
env/
.env/

# ── Temporary files ──
*.tmp
*.log
